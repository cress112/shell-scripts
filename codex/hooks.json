{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$HOME/.codex/hooks/permission_request_auto_allow.py\"",
            "timeout": 30,
            "statusMessage": "Checking global auto-approval policy"
          }
        ]
      }
    ]
  }
}
